# ---------------------------------------------------------------------------
# git-change-bot configuration
# Deployed copy lives at /etc/git-change-bot.env (chmod 600, owner gitbot).
# Every value below is read at process start; nothing has an unsafe default.
# ---------------------------------------------------------------------------

# --- GitHub webhook -------------------------------------------------------
# The "Secret" you set on the repository/organisation webhook. Used to verify
# the X-Hub-Signature-256 HMAC over the raw request body. Required.
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional: plain-token header (X-Hub-Token) for forwarders that cannot sign.
# GITHUB_LEGACY_SECRET_TOKEN=

# Optional: personal access token, only needed for HTTPS clone URLs of private
# repositories. Prefer an SSH deploy key and leave this empty.
# GITHUB_TOKEN=

# Set to false ONLY for local development.
REQUIRE_WEBHOOK_SIGNATURE=true
WEBHOOK_MAX_AGE_SECONDS=300

# --- Slack ----------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ
SLACK_TIMEOUT_SECONDS=10
# Send a cheap, deterministic card when a push touched only ignored files.
NOTIFY_ON_IGNORED_ONLY=false
NOTIFY_ON_BRANCH_DELETE=true
NOTIFY_ON_BRANCH_CREATE=true

# --- LLM ------------------------------------------------------------------
# google (default) | null   ("null" runs the pipeline with no model)
LLM_PROVIDER=google

# Google AI Studio developer API key (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
# 0 disables Gemini 2.5 thinking tokens, which dominate cost on this task.
# Raise it (e.g. 1024) if you want deeper analysis; leave empty for the default.
GOOGLE_THINKING_BUDGET=0

LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# --- Storage --------------------------------------------------------------
# Holds repos/<id>.git mirrors, indexes/<id>/repo-map.json and queue.sqlite3.
BOT_DATA_DIR=/var/lib/git-change-bot

# --- Git ------------------------------------------------------------------
# Read-only SSH key used to fetch mirrors. This VM reuses the system key via a
# protected `gitbot` copy at this path; the key must have GitHub read access.
GIT_SSH_COMMAND=ssh -i /var/lib/git-change-bot/.ssh/id_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=accept-new
GIT_TIMEOUT_SECONDS=600

# --- Cost and size limits -------------------------------------------------
MAX_DIFF_CHARS=60000
MAX_CONTEXT_CHARS=90000
MAX_FILE_CONTEXT_CHARS=16000
MAX_CHANGED_FILES=80
MAX_FILE_DIFF_CHARS=12000
CONTEXT_WINDOW_LINES=50
# Above this many analysable files, group by subsystem and synthesise.
HIERARCHICAL_FILE_THRESHOLD=25
HIERARCHICAL_MAX_GROUPS=8

# --- Queue and worker -----------------------------------------------------
MAX_JOB_ATTEMPTS=5
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=1800
RETRY_BACKOFF_SECONDS=30

# --- Filtering ------------------------------------------------------------
# IGNORE_PATTERNS replaces the built-in list; EXTRA_IGNORE_PATTERNS adds to it.
# Comma-separated or a JSON array.
# IGNORE_PATTERNS=node_modules/**,dist/**,*.lock
EXTRA_IGNORE_PATTERNS=
# Empty means "analyse every branch".
# WATCHED_BRANCHES=main,develop

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
